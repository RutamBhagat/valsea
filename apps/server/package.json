{
  "name": "@valsea/server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "dev": "bun run db:migrate && bun run --hot src/index.ts",
    "start": "bun run db:migrate && bun run dist/index.mjs",
    "test": "bun run db:migrate && bun test --preload ./test/preload.ts ./test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@google/genai": "^2.0.0",
    "@sinclair/typebox": "^0.34.52",
    "@valsea/auth": "workspace:*",
    "@valsea/benchmark": "workspace:*",
    "@valsea/db": "workspace:*",
    "@valsea/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "^1.4.29",
    "file-type": "^22.0.2",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@valsea/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
