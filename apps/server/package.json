    "@valsea/auth": "workspace:*",
    "@valsea/db": "workspace:*",
    "@valsea/env": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "^1.4.29",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@valsea/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
