{
  "name": "@valsea/server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "@grpc/grpc-js": "^1.14.4",
    "@sinclair/typebox": "^0.34.52",
    "@valsea/auth": "workspace:*",
    "@valsea/db": "workspace:*",
    "@valsea/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "elysia": "^1.4.29",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@valsea/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
